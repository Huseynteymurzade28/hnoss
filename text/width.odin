package text

// Display width of a rune in terminal cells: 0, 1 or 2.
//
// Phase 2 stopgap: a hand-picked subset of East Asian Width (W/F) and
// zero-width ranges covering CJK, Hangul, fullwidth forms, the main emoji
// blocks and common combining marks. Phase 4 replaces this with a table
// generated from the Unicode data files.
// Refs: https://www.unicode.org/reports/tr11/  https://man7.org/linux/man-pages/man3/wcwidth.3.html
rune_width :: proc "contextless" (r: rune) -> int {
	switch {
	case r == 0:
		return 0
	case r < 0x20, r >= 0x7f && r < 0xa0:
		return 0 // C0 / DEL / C1 controls: not printable
	case r < 0x300:
		return 1 // fast path: ASCII and Latin-1
	}
	if in_ranges(r, ZERO_WIDTH[:]) {
		return 0
	}
	if in_ranges(r, WIDE[:]) {
		return 2
	}
	return 1
}

@(private = "file")
Range :: struct {
	lo, hi: rune, // inclusive
}

@(private = "file")
in_ranges :: proc "contextless" (r: rune, ranges: []Range) -> bool {
	lo, hi := 0, len(ranges) - 1
	for lo <= hi {
		mid := (lo + hi) / 2
		switch {
		case r < ranges[mid].lo: hi = mid - 1
		case r > ranges[mid].hi: lo = mid + 1
		case: return true
		}
	}
	return false
}

// Sorted, non-overlapping.
@(private = "file", rodata)
ZERO_WIDTH := [?]Range{
	{0x0300, 0x036f}, // combining diacritical marks
	{0x0483, 0x0489},
	{0x0591, 0x05bd},
	{0x0610, 0x061a},
	{0x064b, 0x065f},
	{0x200b, 0x200f}, // zero width space / joiners / direction marks
	{0x202a, 0x202e},
	{0x2060, 0x2064},
	{0x20d0, 0x20ff}, // combining marks for symbols
	{0xfe00, 0xfe0f}, // variation selectors
	{0xfe20, 0xfe2f},
	{0xfeff, 0xfeff}, // BOM / ZWNBSP
	{0xe0100, 0xe01ef},
}

@(private = "file", rodata)
WIDE := [?]Range{
	{0x1100, 0x115f}, // Hangul Jamo initials
	{0x231a, 0x231b},
	{0x2329, 0x232a},
	{0x23e9, 0x23ec},

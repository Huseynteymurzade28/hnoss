package text

import "core:unicode/utf8"

// Display width of a single rune in terminal cells: 0, 1 or 2.
// Controls are 0 (they are never drawn as glyphs).
// Tables: width_table.odin, generated by tools/gen_width.py.
rune_width :: proc "contextless" (r: rune) -> int {
	switch {
	case r < 0x20, r >= 0x7f && r < 0xa0:
		return 0
	case r < 0x300:
		return 1 // fast path: ASCII and Latin-1
	}
	if in_ranges(r, ZERO_WIDTH[:]) {
		return 0
	}
	if in_ranges(r, WIDE[:]) {
		return 2
	}
	return 1
}

// Splits off the first grapheme cluster of `s`: what a terminal draws as
// one glyph. `rest` is the remainder. Covers what matters for display, a
// practical subset of UAX #29 (https://unicode.org/reports/tr29/):
//   - a base followed by combining marks / variation selectors / ZWJ,
//   - ZWJ sequences (👩‍💻), emoji skin-tone modifiers (👍🏽),
//   - regional-indicator pairs (flags, 🇦🇿), CR LF.
// `width` is the cluster's display width. VS16 (U+FE0F, emoji
// presentation) widens a narrow base such as ❤ to 2.
next_grapheme :: proc "contextless" (s: string) -> (cluster: string, width: int, rest: string) {
	if len(s) == 0 {
		return "", 0, ""
	}
	r0, n := utf8.decode_rune_in_string(s)
	i := n
	width = rune_width(r0)

	switch {
	case r0 == '\r' && i < len(s) && s[i] == '\n':
		return s[:i + 1], 0, s[i + 1:]
	case r0 < 0x20 || r0 == 0x7f:
		return s[:i], 0, s[i:]
	case is_regional_indicator(r0):
		if r1, n1 := utf8.decode_rune_in_string(s[i:]); is_regional_indicator(r1) {
			i += n1
		}
		return s[:i], 2, s[i:]
	}

	prev := r0
	for i < len(s) {
		r, rn := utf8.decode_rune_in_string(s[i:])
		joins := prev == ZWJ || is_emoji_modifier(r) || (r >= 0x20 && rune_width(r) == 0)
		if !joins {
			break
		}
		if r == VS16 && width == 1 {
			width = 2
		}
		i += rn
		prev = r
	}
	return s[:i], width, s[i:]
}

// Display width of a string in cells.
width :: proc "contextless" (s: string) -> int {
	total := 0
	for rest := s; len(rest) > 0; {
		_, w, r := next_grapheme(rest)
		total += w
		rest = r
	}
	return total
}

// The longest prefix of `s` that fits in `max_width` cells, never cutting
// a grapheme in half. Also returns that prefix's width.
truncate :: proc "contextless" (s: string, max_width: int) -> (prefix: string, w: int) {
	rest := s
	for len(rest) > 0 {
		_, cw, r := next_grapheme(rest)
		if w + cw > max_width {
			break
		}
		w += cw
		rest = r
	}
	return s[:len(s) - len(rest)], w
}

ZWJ  :: rune(0x200d) // zero width joiner
VS16 :: rune(0xfe0f) // variation selector 16: emoji presentation

@(private)
is_regional_indicator :: proc "contextless" (r: rune) -> bool {
	return r >= 0x1f1e6 && r <= 0x1f1ff
}

@(private)
is_emoji_modifier :: proc "contextless" (r: rune) -> bool {
	return r >= 0x1f3fb && r <= 0x1f3ff
}

@(private)
Range :: struct {
	lo, hi: rune, // inclusive
}

@(private)
in_ranges :: proc "contextless" (r: rune, ranges: []Range) -> bool {
	lo, hi := 0, len(ranges) - 1
	for lo <= hi {
		mid := (lo + hi) / 2
		switch {
		case r < ranges[mid].lo: hi = mid - 1
		case r > ranges[mid].hi: lo = mid + 1
		case: return true
		}
	}
	return false
}
